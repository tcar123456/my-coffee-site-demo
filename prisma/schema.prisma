// Prisma schema — my-coffee-site
// Phase 1: User / Product / ProductImage
// Phase 3a: Cart / CartItem
// Phase 3b: Address / Order / OrderItem / OrderCounter
// Phase 4:  WishlistItem / Subscription（會員中心模組）

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// User — Phase 2 Auth.js（credentials + JWT）
// password 為 credentials 用（OAuth 用戶為 null）
// emailVerified / image 為 Auth.js 標準欄位（Phase 2 用 JWT 不會寫，但 schema 先建好讓 OAuth 啟用無痛）
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  cart          Cart?
  addresses     Address[]
  orders        Order[]
  wishlistItems WishlistItem[]
  subscriptions Subscription[]
}

enum Role {
  CUSTOMER
  SELLER
}

// Auth.js 標準 schema — Phase 2 用 JWT + credentials 不會寫入這三張表，
// 等未來 Google OAuth / 寄信驗證啟用再用，避免再 migrate
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id               String     @id @default(cuid())
  slug             String     @unique
  name             String
  origin           String
  roastLevel       RoastLevel
  processingMethod String
  flavorNotes      String
  description      String?
  price            Int
  weightGram       Int
  stock            Int        @default(0)
  badge            String?
  coverVariant     Int?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  images        ProductImage[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  @@index([isActive])
}

enum RoastLevel {
  LIGHT
  MEDIUM_LIGHT
  MEDIUM
  MEDIUM_DARK
  DARK
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Phase 3a — 購物車
// 一個 User 對應一個 Cart（unique on userId）。CartItem 唯一性由 (cartId, productId, grind, pkg) 三元組保證。
// grind / pkg 直接存 stable enum-like string（lookup label 在 lib/cart-options.ts）。
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  qty       Int
  grind     String?
  pkg       String?
  createdAt DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId, grind, pkg])
  @@index([productId])
}

// Phase 3b — 訂單 / 收件地址
// Order 直接 snapshot 商品名稱 / 售價，避免商品改名 / 改價時影響歷史訂單。
// 金額一律用整數（NTD 沒有小數點），避免浮點誤差。

model Address {
  id        String   @id @default(cuid())
  userId    String
  recipient String
  phone     String
  zipCode   String
  city      String
  district  String
  street    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

model Order {
  id             String         @id @default(cuid())
  orderNumber    String         @unique
  userId         String
  addressId      String
  shippingMethod ShippingMethod
  paymentMethod  PaymentMethod
  status         OrderStatus    @default(PENDING)

  subtotal    Int
  shippingFee Int
  total       Int

  recipientName    String
  recipientPhone   String
  shippingZipCode  String
  shippingCity     String
  shippingDistrict String
  shippingStreet   String

  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  address Address     @relation(fields: [addressId], references: [id], onDelete: Restrict)
  items   OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  productSlug String
  unitPrice   Int
  qty         Int
  grind       String?
  pkg         String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// 訂單編號每日序號計數器；用 dailyKey (YYYYMMDD) 作 PK，
// transaction 內 upsert + increment 保證原子性，避免 count() race。
model OrderCounter {
  dailyKey  String   @id
  lastSeq   Int
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShippingMethod {
  CVS_711
  CVS_FAMILY
  HOME_DELIVERY
}

enum PaymentMethod {
  CREDIT_CARD
  LINE_PAY
  BANK_TRANSFER
  COD
}

// Phase 4 — 會員中心
// WishlistItem：(userId, productId) 三元唯一防重複收藏；onDelete Cascade 在兩端避免幽靈記錄。
// Subscription：假流程 mockup（不接金流、不真出貨）。pricePerShipment 整數 cents-style 同 Order；
// shipmentsDelivered/totalShipments 對應 design reference「已配送 NN 期 / 共續訂 NN 期」。
// nextShipAt 純展示，不會自動推進（cron 留 Phase 6/7）。

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model Subscription {
  id                 String              @id @default(cuid())
  userId             String
  plan               SubscriptionPlan
  cadence            SubscriptionCadence
  status             SubscriptionStatus  @default(ACTIVE)
  nextShipAt         DateTime
  pricePerShipment   Int
  shipmentsDelivered Int                 @default(0)
  totalShipments     Int
  pausedAt           DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum SubscriptionPlan {
  DUAL_BEANS_BIWEEKLY
  SINGLE_BEAN_MONTHLY
}

enum SubscriptionCadence {
  BIWEEKLY
  MONTHLY
}

// Phase 5c — 優惠碼
// 主表 CRUD（賣家後台用）；前台兌換邏輯 + PromoCodeUsage 防同帳號濫用留 Phase 7a。
// discountValue 語意：PERCENT → 1–100 整數（5 = 95 折 5% off）；FIXED → 直接折抵 NT$。
// nullable 語意：maxUses null = 無上限；startsAt null = 立即生效；endsAt null = 永不過期。
model PromoCode {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  discountType  DiscountType
  discountValue Int
  minSubtotal   Int          @default(0)
  maxUses       Int?
  usedCount     Int          @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([isActive])
}

enum DiscountType {
  PERCENT
  FIXED
}
