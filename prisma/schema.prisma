// Prisma schema — my-coffee-site
// Phase 1: User / Product / ProductImage
// Cart / Order / Address / Wishlist 在後續 phase 增加

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// User 預留給 Phase 2 Auth.js
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  CUSTOMER
  SELLER
}

model Product {
  id               String     @id @default(cuid())
  slug             String     @unique
  name             String
  origin           String
  roastLevel       RoastLevel
  processingMethod String
  flavorNotes      String
  description      String?
  price            Int
  weightGram       Int
  stock            Int        @default(0)
  badge            String?
  coverVariant     Int?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  images ProductImage[]

  @@index([isActive])
}

enum RoastLevel {
  LIGHT
  MEDIUM_LIGHT
  MEDIUM
  MEDIUM_DARK
  DARK
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}
