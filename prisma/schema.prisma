// Prisma schema — my-coffee-site
// Phase 1: User / Product / ProductImage
// Cart / Order / Address / Wishlist 在後續 phase 增加

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// User — Phase 2 Auth.js（credentials + JWT）
// password 為 credentials 用（OAuth 用戶為 null）
// emailVerified / image 為 Auth.js 標準欄位（Phase 2 用 JWT 不會寫，但 schema 先建好讓 OAuth 啟用無痛）
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
}

enum Role {
  CUSTOMER
  SELLER
}

// Auth.js 標準 schema — Phase 2 用 JWT + credentials 不會寫入這三張表，
// 等未來 Google OAuth / 寄信驗證啟用再用，避免再 migrate
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id               String     @id @default(cuid())
  slug             String     @unique
  name             String
  origin           String
  roastLevel       RoastLevel
  processingMethod String
  flavorNotes      String
  description      String?
  price            Int
  weightGram       Int
  stock            Int        @default(0)
  badge            String?
  coverVariant     Int?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  images ProductImage[]

  @@index([isActive])
}

enum RoastLevel {
  LIGHT
  MEDIUM_LIGHT
  MEDIUM
  MEDIUM_DARK
  DARK
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}
