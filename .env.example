# 範本檔。實際值請寫到 .env.local（已 gitignore）。
# 部署到 Vercel 時把這些 key 填到 Project Settings → Environment Variables。
# 標 [必填] = production 一定要設；標 [選填] = 未設時程式碼會自動 fallback。

# =====================================================
# [必填] Supabase PostgreSQL（Phase 1 — 資料庫）
# =====================================================
# DATABASE_URL：給 Next.js runtime 走 transaction mode pooler（port 6543）
# DIRECT_URL：  給 Prisma CLI 跑 migrate / generate / db push（session mode，port 5432）
# Supabase Dashboard → Settings → Database → Connection string 兩種模式各拿一條
DATABASE_URL=""
DIRECT_URL=""

# =====================================================
# [必填] Supabase Storage（Phase 5b — 商品圖片上傳）
# =====================================================
# SUPABASE_URL：             Supabase Dashboard → Settings → API → Project URL
# SUPABASE_SERVICE_ROLE_KEY：Supabase Dashboard → Settings → API → service_role secret
#                            （server-only，絕不暴露到 client；故意不加 NEXT_PUBLIC_ 前綴）
# bucket 名稱固定 `product-images`（public read，5 MB 限制，JPEG/PNG/WebP）
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# =====================================================
# [必填] Auth.js v5（Phase 2 — 身份驗證）
# =====================================================
# 用 `pnpm dlx auth secret` 或 `openssl rand -base64 32` 或 PowerShell:
#   $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
#   $bytes = New-Object byte[] 32; $rng.GetBytes($bytes)
#   [Convert]::ToBase64String($bytes)
AUTH_SECRET=""

# Phase 2 延後項目（保留紀錄）：
# - Google OAuth：啟用時需設 AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET
# - 寄信（忘記密碼）：啟用時需設 RESEND_API_KEY 或 SMTP 相關

# =====================================================
# [必填] APP_URL（Phase 6 — callback redirect base）
# =====================================================
# production 填正式 domain（如 `https://my-coffee-site.vercel.app` 或自有 domain）
# dev 留空時 fallback `http://localhost:3000`
# 若用 cloudflared / ngrok tunnel 測 ECPay / LINE Pay callback，填 tunnel URL
APP_URL=""

# =====================================================
# [選填] ECPay AIO 信用卡 sandbox（Phase 6 — 金流）
# =====================================================
# 未設定時自動 fallback ECPay 官方公開測試帳號（3002607 / pwFHCqoQZGmho4w6 / EkRm7iFT261dpevs）
# 切 production 需 ECPAY_ENV=production + 自己的特店憑證
ECPAY_ENV="sandbox"
ECPAY_MERCHANT_ID=""
ECPAY_HASH_KEY=""
ECPAY_HASH_IV=""
ECPAY_AIO_ENDPOINT=""

# =====================================================
# [選填] LINE Pay v3 sandbox（Phase 6c — 金流）
# =====================================================
# 需到 pay.line.me 申請 sandbox channel 取得 Channel ID + Channel Secret
# 未設定時 initiatePayment(LINE_PAY) 會 throw，UI 改顯示「請選其他付款方式」
LINEPAY_CHANNEL_ID=""
LINEPAY_CHANNEL_SECRET=""
LINEPAY_SANDBOX_URL="https://sandbox-api-pay.line.me"

# =====================================================
# [選填] ATM 轉帳收款帳戶（Phase 6d — 顯示在 PENDING + BANK_TRANSFER 訂單詳情頁）
# =====================================================
# 未設定時 fallback placeholder（示範銀行 / 000-123-456789 / 暮焙股份有限公司）
BANK_NAME=""
BANK_ACCOUNT=""
BANK_ACCOUNT_HOLDER=""

# =====================================================
# [選填] ECPay 物流 sandbox（Phase 8a — 物流）
# =====================================================
# 未設定時自動 fallback ECPay 官方物流公開測試帳號（2000132 / 5294y06JbISpM5x9 / v77hoKGq4kWxNNIS）
# production 用 ECPAY_LOGISTICS_ENV=production + 自己物流特店憑證
ECPAY_LOGISTICS_ENV="sandbox"
ECPAY_LOGISTICS_MERCHANT_ID=""
ECPAY_LOGISTICS_HASH_KEY=""
ECPAY_LOGISTICS_HASH_IV=""
ECPAY_LOGISTICS_ENDPOINT=""

# =====================================================
# [選填] 物流寄件人資訊（Phase 8c — 賣家倉庫）
# =====================================================
# 未設定時 fallback 到暮焙咖啡 / 0900000000 / 10617 台北大安羅斯福路四段 1 號
SHOP_SENDER_NAME=""
SHOP_SENDER_CELLPHONE=""
SHOP_SENDER_ZIPCODE=""
SHOP_SENDER_ADDRESS=""
