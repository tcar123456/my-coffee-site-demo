# 範本檔。實際值請寫到 .env.local（已 gitignore）。

# Supabase PostgreSQL
# DATABASE_URL: 給 Next.js runtime 走 transaction mode pooler（port 6543）
# DIRECT_URL:   給 Prisma CLI 跑 migrate / generate（session mode，port 5432）
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Auth.js v5
# 用 `pnpm dlx auth secret` 或 PowerShell:
#   $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
#   $bytes = New-Object byte[] 32; $rng.GetBytes($bytes)
#   [Convert]::ToBase64String($bytes)
AUTH_SECRET=""

# Phase 2 延後項目（保留紀錄）：
# - Google OAuth：啟用時需設 AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET
# - 寄信（忘記密碼）：啟用時需設 RESEND_API_KEY 或 SMTP 相關

# Phase 6 — 付款 sandbox
# 對外 callback URL 都要公網可達（本機開發用 ngrok）；APP_URL 留空時 fallback http://localhost:3000
APP_URL="https://<your-ngrok>.ngrok-free.app"

# ECPay AIO 信用卡 sandbox
# 未設定時自動 fallback 到 ECPay 官方公開測試帳號（3002607 / pwFHCqoQZGmho4w6 / EkRm7iFT261dpevs）
# 切 production 用 ECPAY_ENV=production + 自己的特店憑證
ECPAY_ENV="sandbox"
ECPAY_MERCHANT_ID=""
ECPAY_HASH_KEY=""
ECPAY_HASH_IV=""
ECPAY_AIO_ENDPOINT=""

# LINE Pay v3 sandbox
# 需到 pay.line.me 申請 sandbox channel 取得 Channel ID + Channel Secret
LINEPAY_CHANNEL_ID=""
LINEPAY_CHANNEL_SECRET=""
LINEPAY_SANDBOX_URL="https://sandbox-api-pay.line.me"

# Phase 6d — ATM 轉帳收款帳戶（顯示在 PENDING + BANK_TRANSFER 訂單詳情頁）
# 未設定時 fallback 到 placeholder（示範銀行 / 000-123-456789 / 暮焙股份有限公司）
BANK_NAME=""
BANK_ACCOUNT=""
BANK_ACCOUNT_HOLDER=""
